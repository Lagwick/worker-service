# Web Server
APP_PROCESSOR_WEB_SERVER_LISTEN_PORT=8080

# Monitor
APP_MONITOR_LOG_LEVEL=debug
APP_MONITOR_ENVIRONMENT=development

# Monitor: Sentry (выключен по умолчанию)
APP_MONITOR_SENTRY_ENABLED=false
APP_MONITOR_SENTRY_DSN=

# Monitor: OpenTelemetry (выключен; включите ENABLED и укажите ADDRESS коллектора)
APP_MONITOR_OPEN_TELEMETRY_ENABLED=false
APP_MONITOR_OPEN_TELEMETRY_ADDRESS=localhost:4317
APP_MONITOR_OPEN_TELEMETRY_MAX_QUEUE_SIZE=2048
APP_MONITOR_OPEN_TELEMETRY_MAX_BATCH_SIZE=512
APP_MONITOR_OPEN_TELEMETRY_SEND_BATCH_TIMEOUT=5s
APP_MONITOR_OPEN_TELEMETRY_EXPORT_TIMEOUT=30s
APP_MONITOR_OPEN_TELEMETRY_SAMPLE_RATIO=1

# Broker (Kafka) — укажите ADDRESSES, чтобы включить
APP_BROKER_KAFKA_ADDRESSES=kafka:9092
APP_BROKER_KAFKA_CONSUMER_GROUP=worker-service
APP_BROKER_KAFKA_CLIENT_ID=worker-service
APP_BROKER_KAFKA_MODEL_ORDER_CREATED_TOPIC=order.created

# Redis
APP_REPOSITORY_REDIS_ADDRESS=redis-worker:6379
APP_REPOSITORY_REDIS_PASSWORD=
APP_REPOSITORY_REDIS_DB=0

# Client - Fixer
APP_CLIENT_FIXER_API_KEY=0cdfb3b99fe3854bb68349b9807be4b4
APP_CLIENT_FIXER_BASE_URL=http://data.fixer.io/api
APP_CLIENT_FIXER_CACHE_TTL=30m
